# OpenAI API Key (Backend Only - NEVER expose to React)
OPENAI_API_KEY=

# openFDA API Key (Optional - openFDA functions with rate limits without a key)
OPENFDA_API_KEY=

# LangSmith Tracing (Optional for Phase 1)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=regulatory-content-reuse-finder

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Live Regulatory Sources URLs (NLM DailyMed & FDA openFDA)
DAILYMED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
REQUEST_TIMEOUT_SECONDS=15.0
